# Copy to .env and fill in. Never commit .env.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/coretalents

# Site origins allowed to call the API (comma separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Admin login. Synced to the database on every start - to change the email or
# password, edit these two lines and restart the server.
ADMIN_EMAIL=admin@coretalents.in
ADMIN_PASSWORD=change-me-min-8-chars

# Signs admin sessions. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d

# Popup images are stored on this server's disk
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
