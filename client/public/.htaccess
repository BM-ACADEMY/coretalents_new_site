# For Apache / cPanel / Hostinger hosting. Ignored by Vercel and Netlify.
# Serves the prerendered page for each clean URL (/services -> services.html),
# and falls back to the app shell for anything else.
Options -MultiViews
DirectorySlash Off
RewriteEngine On

# /about.html -> /about (permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /services/ -> /services (permanent)
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /services -> services.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# real files (assets, images, sitemap) as they are
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# everything else -> app shell
RewriteRule ^ index.html [L]
